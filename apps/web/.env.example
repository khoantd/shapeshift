# Shapeshift environment. Copy to .env.local and fill in what you need:
#   cp .env.example .env.local
#
# Everything is optional. With no key, Shapeshift runs fully offline using the
# built-in keyword classifier ("jev-offline"), so the app works out of the box.

# TypeSafe AI API key. When set, intent classification uses the online Jev model.
# Get one at https://console.typesafe.ai/keys. Server-side only; never exposed to the browser.
TYPESAFE_API_KEY=

# Pin the Jev model version so answers don't change under you (jev-latest is an alias).
JEV_MODEL=jev-1.13.0

# Force the offline classifier even when a key is set (handy for UI work and demos).
NEXT_PUBLIC_USE_MOCK=false

# Perplexity Agent API (server-only). Powers news reader "Deep Dive".
# Create a key at https://console.perplexity.ai — never commit the real value.
# PERPLEXITY_API_KEY=
#
# Deep Dive results are stored on Inspired Canvas ba_cxo_feed_items.deep_dive.
# Brief scores are stored on ba_cxo_feed_items.brief.
# Apply inspired-canvas migrations:
#   supabase/migrations/20260926120000_cxo_feed_deep_dive.sql
#   supabase/migrations/20260926130000_cxo_feed_brief.sql
# (or the ALTERs at the end of docs/supabase/cxo_feed.sql) in the IC Supabase SQL Editor.

# Public URL, used for Open Graph metadata when deployed.
# NEXT_PUBLIC_SITE_URL=https://shapeshift.example.com

# Convex waitlist (landing page signup). Run `bunx convex dev` from apps/web
# to create a deployment, then paste the URL here.
# NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
# CONVEX_DEPLOYMENT=

# Inspired Canvas CXO feed (server-only). Same pattern as StratAI / companion:
# copy VITE_SUPABASE_* from inspired-canvas into INSPIRED_CANVAS_SUPABASE_*, then
# either paste a user JWT or mint one via email/password (signInWithPassword).
# INSPIRED_CANVAS_BASE_URL=https://inspired-canvas.vercel.app
# INSPIRED_CANVAS_SUPABASE_URL=https://<ic-project>.supabase.co
# INSPIRED_CANVAS_SUPABASE_PUBLISHABLE_KEY=<ic-anon-or-publishable-key>
# INSPIRED_CANVAS_ACCESS_TOKEN=
# INSPIRED_CANVAS_EMAIL=
# INSPIRED_CANVAS_PASSWORD=