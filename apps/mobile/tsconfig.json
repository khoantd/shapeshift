{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@shapeshift/mobile": ["./theme/index.ts"],
      "@shapeshift/mobile/*": ["./theme/*"]
    },
    "types": ["bun"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["**/node_modules", "**/*.test.ts"]
}
