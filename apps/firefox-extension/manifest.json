{
  "manifest_version": 3,
  "name": "Meanbox",
  "version": "1.0.0",
  "description": "GitHub repo lens, YouTube study companion, and Meanbox search from Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "meanbox@royalsolution",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png"
  },
  "action": {
    "default_title": "Meanbox",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/48.png",
      "96": "icons/96.png"
    }
  },
  "omnibox": {
    "keyword": "mb"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "sidebar_action": {
    "default_title": "Meanbox",
    "default_panel": "sidebar.html",
    "default_icon": {
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://*.github.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "contextMenus", "cookies", "storage", "tabs"],
  "host_permissions": [
    "https://meanbox.vercel.app/*",
    "http://localhost:3000/*",
    "https://github.com/*",
    "https://*.github.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
