{
  "manifest_version": 3,
  "name": "Meanbox",
  "version": "1.3.8",
  "description": "GitHub lens, YouTube study, in-sidebar news deep dive and Quick Gadgets (tip/split/convert/timer/RTCFC), and Places.",
  "browser_specific_settings": {
    "gecko": {
      "id": "meanbox@royalsolution",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png"
  },
  "action": {
    "default_title": "Meanbox",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/48.png",
      "96": "icons/96.png"
    }
  },
  "omnibox": {
    "keyword": "mb"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "sidebar_action": {
    "default_title": "Meanbox",
    "default_panel": "sidebar.html",
    "default_icon": {
      "48": "icons/48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://*.github.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "contextMenus",
    "cookies",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://meanbox.vercel.app/*",
    "http://localhost:3000/*",
    "https://github.com/*",
    "https://*.github.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
