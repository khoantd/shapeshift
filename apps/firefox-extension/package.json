{
  "name": "@shapeshift/firefox-extension",
  "version": "1.3.8",
  "private": true,
  "description": "Meanbox Firefox add-on (GitHub lens, YouTube study, saved news deep dive, Quick Gadgets incl. RTCFC, Places).",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "web-ext run --source-dir .",
    "lint": "web-ext lint --source-dir .",
    "build": "web-ext build --source-dir . --overwrite-dest",
    "build:amo": "bash ./build.sh",
    "pack:source": "bash ./pack-source.sh",
    "test": "bun test ./lib/api.test.js ./lib/article.test.js ./lib/config.test.js ./lib/gadgets.test.js ./lib/localHistory.test.js ./lib/parse.test.js ./lib/paths.test.js ./lib/ui.test.js"
  },
  "devDependencies": {
    "web-ext": "8.10.0"
  }
}
