{
  "name": "@shapeshift/firefox-extension",
  "version": "1.3.1",
  "private": true,
  "description": "Meanbox Firefox add-on (GitHub lens, YouTube study, saved news deep dive, Quick Gadgets incl. RTCFC, Places).",
  "scripts": {
    "dev": "bunx web-ext run --source-dir .",
    "lint": "bunx web-ext lint --source-dir .",
    "build": "bunx web-ext build --source-dir . --overwrite-dest",
    "test": "bun test ./lib/api.test.js ./lib/article.test.js ./lib/config.test.js ./lib/gadgets.test.js ./lib/parse.test.js ./lib/paths.test.js ./lib/ui.test.js"
  },
  "devDependencies": {
    "web-ext": "8.10.0"
  }
}
