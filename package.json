{
  "name": "shapeshift-monorepo",
  "version": "0.1.0",
  "devDependencies": {
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5"
  },
  "description": "Meanbox monorepo — morphing input SDK and demo web app.",
  "ignoreScripts": ["sharp", "unrs-resolver"],
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "private": true,
  "scripts": {
    "dev": "bun run --filter @shapeshift/web dev",
    "build": "bun run --filter @shapeshift/web build",
    "start": "bun run --filter @shapeshift/web start",
    "lint": "bun run --filter @shapeshift/web lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages/core packages/react apps/web apps/firefox-extension apps/mobile",
    "format": "prettier --write .",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "trustedDependencies": ["sharp", "unrs-resolver"],
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "react-native": "0.86.3",
    "@react-native/virtualized-lists": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/js-polyfills": "0.86.3",
    "@react-native/metro-babel-transformer": "0.86.3",
    "@react-native/babel-preset": "0.86.3"
  }
}
