# Shapeshift environment. Copy into the Next app and fill in what you need:
#   cp .env.example apps/web/.env.local
#
# Everything is optional. With no key, Shapeshift runs fully offline using the
# built-in keyword classifier ("jev-offline"), so the app works out of the box.

# TypeSafe AI API key. When set, intent classification uses the online Jev model.
# Get one at https://console.typesafe.ai/keys. Server-side only; never exposed to the browser.
TYPESAFE_API_KEY=

# Pin the Jev model version so answers don't change under you (jev-latest is an alias).
JEV_MODEL=jev-1.13.0

# Force the offline classifier even when a key is set (handy for UI work and demos).
NEXT_PUBLIC_USE_MOCK=false

# Perplexity Agent API (server-only). Powers news reader "Deep Dive" and
# /youtube "Generate learning pack". Create a key at https://console.perplexity.ai
# — never commit the real value.
# PERPLEXITY_API_KEY=
#
# Deep Dive results persist on Inspired Canvas ba_cxo_feed_items.deep_dive —
# Brief scores persist on ba_cxo_feed_items.brief —
# run inspired-canvas migrations 20260926120000_cxo_feed_deep_dive.sql and
# 20260926130000_cxo_feed_brief.sql first.

# Public URL, used for Open Graph metadata when deployed.
# NEXT_PUBLIC_SITE_URL=https://shapeshift.example.com

# Convex waitlist (landing page at /). From apps/web: `bunx convex dev`, then set:
# NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud

# Places map provider: google | maptiler | serpapi (auto if unset).
# PLACES_PROVIDER=serpapi

# Google Places + Maps (when PLACES_PROVIDER=google).
# Server key: Places API (New) — never expose to the browser.
# GOOGLE_MAPS_API_KEY=
# Client key: Maps JavaScript API (HTTP-referrer restricted in GCP).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID for Advanced Markers; omit to use classic Marker.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# YouTube Data API v3 (server-only) — powers /youtube search + details.
# Enable YouTube Data API v3 in Google Cloud and create a restricted key.
# Learning packs also need PERPLEXITY_API_KEY (above); captions often require paste.
# YOUTUBE_DATA_API_KEY=
#
# Optional OAuth for captions.list + captions.download (videos YOU own only).
# Create an OAuth Web client in the same GCP project; add redirect:
#   http://localhost:3000/api/youtube/oauth/callback
# Then open /youtube → Sign in with Google (or /api/youtube/oauth/start?mode=setup to mint a refresh token).
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# Optional server-wide fallback (skip user login) — prefer Sign in with Google:
# YOUTUBE_OAUTH_REFRESH_TOKEN=
# Must match Google Console exactly (use if localhost vs 127.0.0.1 mismatches):
# YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback
# Optional: allow oauth setup outside development when this secret matches ?setupSecret=
# YOUTUBE_OAUTH_SETUP_SECRET=

# MapTiler (when PLACES_PROVIDER=maptiler). Free key: https://cloud.maptiler.com/account/keys/
# MAPTILER_API_KEY=
# NEXT_PUBLIC_MAPTILER_API_KEY=

# SerpAPI Google Maps search (when PLACES_PROVIDER=serpapi). https://serpapi.com/manage-api-key
# Search only — map tiles: MapTiler/Google public key if set, else OpenStreetMap (no key).
# Also powers /github topic headlines (Google News engine).
# SERPAPI_API_KEY=

# GitHub API (optional, server-only) — higher Search rate limits for /github trending.
# Create a classic PAT or fine-grained token with public repo read.
# GITHUB_TOKEN=

# --- GitHub narrated video (Remotion MP4 + OpenAI TTS + MinIO) ---
# OPENAI_API_KEY=          # TTS for /api/github/video
# MinIO (S3-compatible). Local: docker compose -f docker-compose.minio.yml up -d
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=shapeshift-videos
# MINIO_REGION=us-east-1
# MINIO_USE_SSL=false
# Browser playback uses same-origin /api/github/video/file (not raw MinIO URLs)
# so HTTPS pages work when MinIO is http-only.
# Optional local Chromium for Remotion (defaults to Remotion's Chrome download):
# REMOTION_CHROME_EXECUTABLE=
# Optional Remotion company license:
# REMOTION_LICENSE_KEY=

# TextFlow YouTube transcript proxy for /youtube on Vercel (service key, not user JWT).
# Host or host+/api both work — client calls POST …/api/videos/transcript/proxy
# TEXTFLOW_API_URL=https://textflow.sutools.app
# TEXTFLOW_API_KEY=   # same value as TextFlow TEXTFLOW_SERVICE_KEY

# Neo4j (YouTube + news knowledge graphs). Optional — local graphs work without it.
# Google OAuth (same cookies as /youtube) also saves news graphs to Convex for
# personal knowledge + Compare & Link on /news?view=knowledge.
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# Force map tiles: osm | maptiler | google (default: auto, OSM as no-key fallback)
# PLACES_MAP_TILES=osm

# Lead Flow inbound leads (Places → Add contact). Server-only — never expose to the browser.
# Create a key in Lead Flow → Organization → API keys. Rotate if the key was ever pasted in chat.
# LEAD_FLOW_API_KEY=
# LEAD_FLOW_BASE_URL=https://lead-flow-gilt.vercel.app
# LEAD_FLOW_CHANNEL_ID=ch-35ed1c04
# Optional campaign tag sent as source_campaign (default: shapeshift-places)
# LEAD_FLOW_SOURCE_CAMPAIGN=shapeshift-places

# Inspired Canvas CXO feed (server-only). Same pattern as StratAI / companion:
# copy VITE_SUPABASE_* from inspired-canvas into INSPIRED_CANVAS_SUPABASE_*, then
# either paste a user JWT or mint one via email/password (signInWithPassword).
# INSPIRED_CANVAS_BASE_URL=https://inspired-canvas.vercel.app
# INSPIRED_CANVAS_SUPABASE_URL=https://<ic-project>.supabase.co
# INSPIRED_CANVAS_SUPABASE_PUBLISHABLE_KEY=<ic-anon-or-publishable-key>
# INSPIRED_CANVAS_ACCESS_TOKEN=
# INSPIRED_CANVAS_EMAIL=
# INSPIRED_CANVAS_PASSWORD=