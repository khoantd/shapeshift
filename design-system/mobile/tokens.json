{
  "meta": {
    "name": "Meanbox Mobile",
    "version": "1.0.0",
    "source": "packages/react/src/styles.css",
    "colorScheme": "light",
    "notes": "Extends web/extension tokens. Do not fork colors without updating packages/react and extension --mb-* mirrors."
  },
  "color": {
    "background": "#fafaf9",
    "foreground": "#1a1a19",
    "card": "#ffffff",
    "cardForeground": "#1a1a19",
    "popover": "#ffffff",
    "popoverForeground": "#1a1a19",
    "primary": "#1a1a19",
    "primaryForeground": "#fafaf9",
    "secondary": "#f4f4f2",
    "secondaryForeground": "#1a1a19",
    "muted": "#f4f4f2",
    "mutedForeground": "#706e68",
    "accent": "#ecfdf8",
    "accentForeground": "#0f766e",
    "destructive": "#e03131",
    "border": "#e8e7e4",
    "input": "#e8e7e4",
    "ring": "#0f766e",
    "brand": "#0f766e",
    "brandSoft": "#ecfdf8",
    "ink2": "#57564f",
    "lineStrong": "#d6d4cf",
    "positive": "#2f9e44",
    "caution": "#e8590c",
    "cautionText": "#bb4c19",
    "swatchOutline": "rgba(26, 26, 25, 0.06)"
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 28,
    "3xl": 28,
    "shell": 28,
    "pill": 9999
  },
  "shadow": {
    "rest": {
      "ios": [
        { "offsetY": 1, "blur": 2, "color": "rgba(26, 26, 25, 0.04)" },
        { "offsetY": 1, "blur": 1, "color": "rgba(26, 26, 25, 0.03)" }
      ],
      "css": "0 1px 2px rgb(26 26 25 / 0.04), 0 1px 1px rgb(26 26 25 / 0.03)"
    },
    "lift": {
      "ios": [
        { "offsetY": 1, "blur": 2, "color": "rgba(26, 26, 25, 0.04)" },
        { "offsetY": 8, "blur": 24, "color": "rgba(26, 26, 25, 0.08)" }
      ],
      "css": "0 1px 2px rgb(26 26 25 / 0.04), 0 8px 24px -6px rgb(26 26 25 / 0.08)"
    },
    "float": {
      "ios": [
        { "offsetY": 2, "blur": 4, "color": "rgba(26, 26, 25, 0.04)" },
        { "offsetY": 20, "blur": 48, "color": "rgba(26, 26, 25, 0.14)" }
      ],
      "css": "0 2px 4px rgb(26 26 25 / 0.04), 0 20px 48px -12px rgb(26 26 25 / 0.14)"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": ["Geist", "ui-sans-serif", "system-ui", "sans-serif"],
      "mono": ["Geist Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
      "heading": ["Geist", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "scale": {
      "display": { "fontSize": 28, "fontWeight": "650", "lineHeight": 1.2, "letterSpacing": -0.02 },
      "title": { "fontSize": 20, "fontWeight": "650", "lineHeight": 1.25, "letterSpacing": -0.02 },
      "body": { "fontSize": 16, "fontWeight": "400", "lineHeight": 1.5 },
      "bodyReader": { "fontSize": 16, "fontWeight": "400", "lineHeight": 1.65 },
      "callout": { "fontSize": 15, "fontWeight": "500", "lineHeight": 1.45 },
      "caption": { "fontSize": 13, "fontWeight": "400", "lineHeight": 1.4 },
      "micro": { "fontSize": 11, "fontWeight": "500", "lineHeight": 1.3 }
    }
  },
  "spacing": {
    "unit": 4,
    "gutterPhone": 16,
    "gutterLarge": 20,
    "sectionGap": 12,
    "sectionGapLg": 16,
    "tabBarHeight": 56,
    "headerHeight": 48,
    "touchMin": 44
  },
  "motion": {
    "durationMs": 150,
    "pressScale": 0.96,
    "easeOut": [0.23, 1, 0.32, 1],
    "toastSwipeDismissPx": 45
  },
  "icon": {
    "strokeWidth": 1.75,
    "set": "lucide"
  },
  "brandSurface": {
    "image": "brand/main.jpg",
    "headerImage": "brand/header.jpg",
    "scrim": {
      "light": 0.5,
      "medium": 0.7,
      "heavy": 0.85
    },
    "tones": {
      "sidebar": { "scrub": "medium", "position": "left center" },
      "main": { "scrub": "light", "position": "center top" },
      "header": { "scrub": "medium", "position": "center bottom" },
      "rail": { "scrub": "medium", "position": "left top" }
    }
  },
  "extensionAlias": {
    "--mb-bg": "color.background",
    "--mb-surface": "color.card",
    "--mb-border": "color.border",
    "--mb-text": "color.foreground",
    "--mb-muted": "color.mutedForeground",
    "--mb-accent": "color.brand",
    "--mb-accent-dim": "#0d9488",
    "--mb-accent-soft": "color.brandSoft",
    "--mb-danger": "color.destructive",
    "--mb-ok": "color.positive",
    "--mb-radius": "radius.md",
    "--mb-font": "typography.fontFamily.sans",
    "--mb-mono": "typography.fontFamily.mono",
    "--mb-shadow-rest": "shadow.rest.css"
  }
}
